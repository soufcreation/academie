# ============================================================
#  Académie Européenne des Sports — .htaccess
#  Hébergement : OVH mutualisé Apache
#  Sécurité maximale — site statique Next.js + Google Maps
# ============================================================


# ============================================================
#  1. FORCER HTTPS — À activer une fois SSL confirmé sur OVH
#     Vérifie d'abord que https://academie-europeenne.eu
#     fonctionne bien dans ton navigateur, puis décommente
#     ces lignes en retirant le # devant chaque RewriteCond/Rule
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # -- Décommente les 2 lignes ci-dessous pour forcer HTTPS --
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Supprimer le www → redirige www.academie-europeenne.eu vers academie-europeenne.eu
    RewriteCond %{HTTP_HOST} ^www\.academie-europeenne\.eu [NC]
    RewriteRule ^(.*)$ https://academie-europeenne.eu/$1 [L,R=301]

</IfModule>


# ============================================================
#  2. ROUTING NEXT.JS
#     Permet d'accéder à /planning, /equipe, etc. directement
#     dans l'URL sans tomber sur une erreur 404 Apache
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ne pas toucher aux fichiers et dossiers qui existent déjà
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Si le dossier /nom-de-page/index.html existe → le servir
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
    RewriteRule ^(.+[^/])$ /$1/index.html [L]

    # Sinon → afficher la page 404 personnalisée
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /404/index.html [L]

</IfModule>


# ============================================================
#  3. EN-TÊTES DE SÉCURITÉ HTTP
# ============================================================

<IfModule mod_headers.c>

    # Empêche le navigateur de deviner le type MIME d'un fichier
    # → bloque l'exécution de fichiers malveillants mal typés
    Header set X-Content-Type-Options "nosniff"

    # Empêche le site d'être intégré dans une iframe sur un autre site
    # → protège contre le clickjacking (faux boutons transparents par-dessus)
    Header set X-Frame-Options "DENY"

    # Contrôle l'info "d'où vient le visiteur" envoyée aux sites externes
    # → envoie seulement le domaine, pas l'URL complète
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Désactive les APIs sensibles du navigateur
    # → un script ne peut pas activer caméra, micro, géoloc, etc.
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=()"

    # Force HTTPS pour 1 an une fois activé
    # → À décommenter en même temps que la règle HTTPS ci-dessus
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy — avec Google Maps et Cloudinary autorisés
    # Définit exactement quelles sources peuvent charger quoi
    Header set Content-Security-Policy "\
        default-src 'self'; \
        script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maps.googleapis.com; \
        img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://res.cloudinary.com; \
        font-src 'self' data: https://fonts.gstatic.com; \
        media-src 'self' https://res.cloudinary.com; \
        frame-src https://www.google.com/maps/ https://maps.google.com/; \
        connect-src 'self' https://maps.googleapis.com https://*.googleapis.com https://res.cloudinary.com; \
        object-src 'none'; \
        base-uri 'self'; \
        form-action 'self'; \
        frame-ancestors 'none'; \
        upgrade-insecure-requests"

    # Masque la version d'Apache aux attaquants
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Server

</IfModule>


# ============================================================
#  4. BLOQUER L'ACCÈS AUX FICHIERS SENSIBLES
#     Empêche d'accéder directement à des fichiers
#     qui ne devraient jamais être visibles publiquement
# ============================================================

<FilesMatch "(^\.htaccess|^\.htpasswd|^\.env|^\.git|\.log$|\.sh$|\.bak$|\.sql$)">
    Require all denied
</FilesMatch>


# ============================================================
#  5. DÉSACTIVER LA LISTE DES FICHIERS D'UN DOSSIER
#     Sans ça, Apache peut afficher le contenu d'un dossier
#     si aucun index.html n'est présent dedans
# ============================================================

Options -Indexes


# ============================================================
#  6. COMPRESSION GZIP
#     Réduit le poids des fichiers envoyés au navigateur
#     Un JS de 100 Ko devient ~30 Ko en transit
# ============================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/woff
</IfModule>


# ============================================================
#  7. CACHE NAVIGATEUR
#     Durée pendant laquelle le navigateur garde les fichiers
#     en mémoire avant de les re-télécharger
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On

    # HTML → 1 heure (le contenu peut changer)
    ExpiresByType text/html                   "access plus 1 hour"

    # CSS & JS → 1 an
    # Next.js met un hash dans le nom des fichiers (_next/static/chunks/abc123.js)
    # donc quand le code change, c'est un nouveau fichier avec un nouveau nom
    # → on peut mettre 1 an sans risque de servir du vieux code
    ExpiresByType text/css                    "access plus 1 year"
    ExpiresByType application/javascript      "access plus 1 year"
    ExpiresByType text/javascript             "access plus 1 year"

    # Images → 1 mois
    ExpiresByType image/webp                  "access plus 1 month"
    ExpiresByType image/png                   "access plus 1 month"
    ExpiresByType image/jpg                   "access plus 1 month"
    ExpiresByType image/jpeg                  "access plus 1 month"
    ExpiresByType image/gif                   "access plus 1 month"
    ExpiresByType image/svg+xml               "access plus 1 month"
    ExpiresByType image/avif                  "access plus 1 month"

    # Icônes & polices → 1 an (quasi jamais modifiés)
    ExpiresByType image/x-icon               "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon   "access plus 1 year"
    ExpiresByType font/woff2                 "access plus 1 year"
    ExpiresByType font/woff                  "access plus 1 year"
    ExpiresByType application/font-woff2     "access plus 1 year"

    # PDF → 1 semaine (formulaires d'inscription)
    ExpiresByType application/pdf            "access plus 1 week"

</IfModule>


# ============================================================
#  8. TYPE MIME POUR LES POLICES WOFF2
#     Évite que certains serveurs Apache servent les polices
#     avec un mauvais type et que le navigateur les refuse
# ============================================================

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff  .woff
    AddType image/avif .avif
    AddType image/webp .webp
</IfModule>
